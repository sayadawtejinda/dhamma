rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone signed in (anonymously) can read and write app data.
    // This is appropriate for this app because the app itself
    // enforces teacher-vs-student permissions in its own logic.
    match /artifacts/{appId}/public/data/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
